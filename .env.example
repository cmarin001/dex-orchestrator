# Decision mode. Strategies runs without any model service.
OPERATING_MODE=strategies
# Optional comma-separated provider IDs. Edit config/providers.json for endpoints and capabilities.
MODEL_PROVIDERS=
MODEL_PROVIDER_POLICY={}
BUDGET_PATH=data/budget.jsonl
# Optional validated observation feed produced by a trusted data collector.
STRATEGY_EVIDENCE_PATH=
# Provider keys are required only for the corresponding enabled remote provider.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
# JSON array of {chain, token, pair}; chains are ethereum, bsc, base, solana, polygon, arbitrum, optimism.
WATCHLIST=[]
LOOP_INTERVAL_MS=90000
BREAKER_FAILURES=3
BREAKER_COOLDOWN_MS=180000
INITIAL_EQUITY_CENTS=100000
MAX_POSITION_BPS=100
MAX_OPEN_POSITIONS=5
AUDIT_PATH=data/audit.jsonl
CONTROL_INBOX_PATH=data/controls
GOPLUS_ACCESS_TOKEN=
ETHERSCAN_API_KEY=
X_BEARER_TOKEN=
REDDIT_ACCESS_TOKEN=
REDDIT_SUBREDDIT=

# Optional dashboard and continuous-paper features
DASHBOARD_API_TOKEN=
DASHBOARD_API_PORT=8787
MCP_PORT=8788
# Add the reverse-proxy hostname when enabling remote MCP.
# MCP_ALLOWED_HOSTS=desk.example.com,127.0.0.1:8788
DASHBOARD_ORIGIN=
DASHBOARD_OPERATOR=operator
RISK_CONFIG_PATH=data/risk-config.jsonl
MAX_EQUITY_AGE_SEC=120
MAX_RISK_CONFIG_AGE_SEC=3600
REQUIRE_RISK_CONFIG=false
ENABLE_DISCOVERY=false
PAPER_EXIT_MODE=profit_only
MARK_REFRESH_MS=5000

# Structured operational logging. debug, info, warn, error, or silent.
LOG_LEVEL=info

# Paper mode is the default. Live uses a dedicated writable AUDIT_PATH.
EXECUTION_MODE=paper
LIVE_CHAIN=base
WALLET_MODE=env
LIVE_RPC_URL=
LIVE_MAX_FEE_NATIVE=
LIVE_CONFIRMATIONS=
DAILY_LIMIT_USD=
PER_TRADE_LIMIT_USD=
MEV_PROTECTION=false
ZEROX_API_KEY=
JUPITER_API_KEY=
# Approved settlement mint/address, token decimals, and USD upper bound per unit.
LIVE_SETTLEMENT_TOKEN=
LIVE_SETTLEMENT_DECIMALS=6
LIVE_SETTLEMENT_MAX_USD=1
LIVE_TOKEN_DECIMALS={}
# Keep signer credentials in the worker-only environment file.
EVM_PRIVATE_KEY=
SOLANA_PRIVATE_KEY=
AWS_KMS_KEY_ID=
AWS_REGION=
# Native-only Bitcoin transfer, using a Bitcoin Core wallet RPC.
BITCOIN_PRIVATE_KEY=
BITCOIN_TESTNET=false
BITCOIN_TRANSFER=
