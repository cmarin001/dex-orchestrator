# Required. The model must support Responses tools and Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# JSON array of {chain, token, pair}; chains are ethereum, bsc, base, solana, polygon, arbitrum.
WATCHLIST=[]
LOOP_INTERVAL_MS=90000
BREAKER_FAILURES=3
BREAKER_COOLDOWN_MS=180000
INITIAL_EQUITY_CENTS=100000
MAX_POSITION_BPS=100
MAX_OPEN_POSITIONS=5
AUDIT_PATH=data/audit.jsonl
CONTROL_INBOX_PATH=data/controls
GOPLUS_ACCESS_TOKEN=
ETHERSCAN_API_KEY=
X_BEARER_TOKEN=
REDDIT_ACCESS_TOKEN=
REDDIT_SUBREDDIT=

# Optional dashboard and continuous-paper features
DASHBOARD_API_TOKEN=
DASHBOARD_API_PORT=8787
MCP_PORT=8788
# Add the reverse-proxy hostname when enabling remote MCP.
# MCP_ALLOWED_HOSTS=desk.example.com,127.0.0.1:8788
DASHBOARD_ORIGIN=
DASHBOARD_OPERATOR=operator
RISK_CONFIG_PATH=data/risk-config.jsonl
MAX_EQUITY_AGE_SEC=120
MAX_RISK_CONFIG_AGE_SEC=3600
REQUIRE_RISK_CONFIG=false
ENABLE_DISCOVERY=false
PAPER_EXIT_MODE=profit_only
MARK_REFRESH_MS=5000

# Structured operational logging. debug, info, warn, error, or silent.
LOG_LEVEL=info
