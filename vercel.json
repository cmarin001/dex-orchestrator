{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "functions": {
    "api/paper.ts": {
      "maxDuration": 90,
      "includeFiles": "prompts/**"
    },
    "api/dashboard-data.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/paper"
    }
  ]
}
