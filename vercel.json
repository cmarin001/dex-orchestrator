{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && npm --prefix dashboard run build && mkdir -p public/dashboard && cp -R dashboard/dist/. public/dashboard/",
  "functions": {
    "api/paper.ts": {
      "maxDuration": 90,
      "includeFiles": "prompts/**"
    },
    "api/dashboard-data.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/paper"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    }
  ],
  "installCommand": "npm install && npm --prefix dashboard install"
}
