{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && mkdir -p public",
  "functions": {
    "api/paper.ts": {
      "maxDuration": 90,
      "includeFiles": "prompts/**"
    }
  },
  "rewrites": [{ "source": "/", "destination": "/api/paper" }]
}
