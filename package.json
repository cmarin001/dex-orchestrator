{
  "name": "trade-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/unit/*.test.mjs tests/integration/*.test.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "dashboard:api": "node --env-file-if-exists=.env --import tsx src/dashboard-api/server.ts",
    "simulate": "node --import tsx --test tests/integration/simulation.test.ts",
    "mcp": "node --env-file-if-exists=.env --import tsx src/mcp/server.ts",
    "lint": "tsc --noEmit",
    "research": "node --import tsx src/agent-runtime/cli.ts",
    "research:calibrate": "node --import tsx src/learning/shadow-cli.ts",
    "research:replay": "node --import tsx src/learning/replay-cli.ts",
    "bench:candidate": "node --import tsx scripts/benchmark-candidate.ts",
    "evidence:candles": "node --import tsx scripts/fetch-market-candles.ts",
    "bench:early-momentum": "node --import tsx scripts/benchmark-early-momentum.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1175.0",
    "@hono/node-server": "2.1.9",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/curves": "2.4.0",
    "@noble/ed25519": "3.2.0",
    "@scure/bip32": "2.0.1",
    "@scure/bip39": "2.0.1",
    "@scure/btc-signer": "2.4.1",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "hono": "4.13.19",
    "jose": "6.2.18",
    "viem": "2.38.5",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "20.19.24",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
